# FalkorDB (local docker defaults shown; FalkorDB Cloud values go here for deploy)
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
RIPPLE_GRAPH=ripple

# LLM provider: gemini (build) or anthropic (final)
RIPPLE_PROVIDER=gemini
GEMINI_API_KEY=
RIPPLE_GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
RIPPLE_CLAUDE_MODEL=claude-opus-5-5
RIPPLE_EFFORT=low
